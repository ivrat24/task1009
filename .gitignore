# Secrets / local env
.env
.env.*
*.pem
*.key

# Python / OS
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db

# Hugging Face / download caches
.cache/
**/.cache/
*.parquet
*.parquet.metadata
*.lock

# Raw SWE-chat payloads (re-download if needed)
data/raw/parquet/
data/raw/transcripts/
data/raw/.cache/
data/cleaned_backup_*/

# Ignore bulky session dumps by default…
**/sessions.jsonl
**/sessions.js
# …but keep the active 500-session cleaned corpus for this repo
!data/cleaned/sessions.jsonl
!data/cleaned/sessions.js

# Local download / import logs
data/*.log

# Optional local label dumps (keep README)
labels/*.json
labels/*.jsonl
labels/*.xlsx
!labels/README.txt
